{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DemoBucketOps",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::ack-adopt-demo-*",
        "arn:aws:s3:::ack-adopt-demo-*/*"
      ]
    },
    {
      "Sid": "ListAllBuckets",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    }
  ]
}