# Copy to .env (gitignored) and fill in. Scripts source this file automatically.

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Prefix for the test bucket; full name will be ${BUCKET_PREFIX}-<unix-timestamp>
BUCKET_PREFIX=ack-adopt-demo

# Pin to a real chart version. Find available versions with:
#   helm show chart oci://public.ecr.aws/aws-controllers-k8s/s3-chart
ACK_CHART_VERSION=
